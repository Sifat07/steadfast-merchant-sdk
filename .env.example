# Copy to .env (never commit it). From the Steadfast merchant panel → API.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# Optional — defaults to https://portal.packzy.com/api/v1
# STEADFAST_BASE_URL=
# The Bearer token you set in the panel's webhook settings
# STEADFAST_WEBHOOK_TOKEN=
# Smoke-test only: a consignment ID that already exists on your account (read-only lookup)
# STEADFAST_SMOKE_CONSIGNMENT_ID=
# STEADFAST_SMOKE_INVOICE=
